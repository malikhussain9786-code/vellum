# Copy this file to .env and fill in your own key. Never commit .env itself.
#
# Get a free Groq API key at:
# https://console.groq.com/keys
#
# Groq's free tier gives generous rate limits (varies by model, typically
# 1,000+ requests/day) — more than enough for personal use.

GROQ_API_KEY=your_key_here

# Optional — only needed if you want to use a different Groq model.
# Defaults to openai/gpt-oss-120b if not set (Groq's officially
# recommended general-purpose model as of mid-2026). Groq has deprecated
# models before (llama-3.1-8b-instant and llama-3.3-70b-versatile were
# both retired in June 2026) — if AI features stop working with a "model
# not found" or "decommissioned" error, check
# https://console.groq.com/docs/models for the current recommended model
# and set it here — no code changes needed.
# GROQ_MODEL=openai/gpt-oss-120b
