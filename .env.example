# Copy this file to .env and fill in your own key. Never commit .env itself.
#
# Get a free Gemini API key (no credit card required) at:
# https://aistudio.google.com/apikey
#
# The free tier includes 1,500 requests/day on Gemini 2.5 Flash — more
# than enough for personal use.

GEMINI_API_KEY=your_api_key_here

# Optional — only needed if you want to use a different Gemini model.
# Defaults to gemini-3-flash-preview if not set (current free-tier model
# as of mid-2026). Google renames/retires Gemini models frequently — if
# AI features stop working with a "model not found" or "not available"
# error, check https://ai.google.dev/gemini-api/docs/models for the
# current free-tier model name and set it here — no code changes needed.
# GEMINI_MODEL=gemini-3-flash-preview
